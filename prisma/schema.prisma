generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// KULLANICI & KİMLİK DOĞRULAMA MODELLERİ
// --------------------------------------

/// Kullanıcı Modeli
/// Sistemdeki müşterileri ve yöneticileri temsil eder.
model User {
  id            String    @id @default(cuid())
  firstName     String?   // Ad
  lastName      String?   // Soyad
  email         String?   @unique // E-posta (Benzersiz)
  emailVerified DateTime? // E-posta doğrulama tarihi
  image         String?   // Profil resmi URL'i
  passwordHash  String?   // Şifrelenmiş parola (bcrypt)
  role          Role      @default(USER) // Kullanıcı rolü (USER, ADMIN)
  
  isActive      Boolean   @default(true) // Hesap aktif mi?
  userAgreement Boolean   @default(false) // Kullanıcı sözleşmesi onayı

  createdAt     DateTime  @default(now()) // Kayıt tarihi
  updatedAt     DateTime  @updatedAt // Güncelleme tarihi
  phoneNumber   String?   // Telefon numarası
  
  // İlişkiler
  accounts      Account[] // OAuth hesapları (Google, Facebook vb.)
  addresses     Address[] // Kayıtlı adresler
  favorites     Favorite[] // Favori ürünler
  orders        Order[]   // Siparişler
  reviews       Review[]  // Ürün yorumları
  sessions      Session[] // Oturum bilgileri
}

/// OAuth Hesapları
/// Google, Facebook gibi sağlayıcılar ile giriş yapıldığında oluşur.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Oturum Modeli
/// Giriş yapan kullanıcıların oturum bilgilerini tutar.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Kullanıcı Adresleri
/// Teslimat ve fatura adreslerini saklar.
model Address {
  id          String   @id @default(cuid())
  title       String   // Adres başlığı (Ev, İş vb.)
  firstName   String   // Alıcı Adı
  lastName    String   // Alıcı Soyadı
  phone       String   // İletişim Telefonu
  addressLine String   // Açık Adres
  city        String   // İl
  district    String   // İlçe
  zipCode     String?  // Posta Kodu
  country     String   @default("Türkiye") // Ülke
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDefault   Boolean  @default(false) // Varsayılan adres mi?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// ÜRÜN KATALOĞU MODELLERİ
// --------------------------------------

/// Kategori Modeli
/// Hiyerarşik kategori yapısını destekler (Giyim -> Erkek -> Gömlek).
model Category {
  id        String   @id @default(cuid())
  name      String   @unique // Kategori adı
  slug      String   @unique // URL dostu isim
  createdAt DateTime @default(now())
  parentId  String?  // Üst kategori ID'si
  updatedAt DateTime @updatedAt

  attributes Attribute[] // Kategoriye özel özellikler (örn: Beden, Renk)
  
  // Kategori Hiyerarşisi (Alt-Üst Kategori)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[] // Bu kategorideki ürünler
  
  // Kategori - Marka (Many-to-Many)
  brands   Brand[]    @relation("CategoryToBrand")
  
  // Kategoriye özel kuponlar için
  coupons  Coupon[]   
}

/// Marka Modeli
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique // Marka adı
  slug      String   @unique // URL dostu isim
  logo      String?  // Marka logosu URL'i
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]  // Markanın ürünleri
  categories Category[] @relation("CategoryToBrand") // Markanın bulunduğu kategoriler
}

/// Ürün Modeli
/// E-ticaret sisteminin temel parçası.
model Product {
  id          String   @id @default(cuid())
  name        String   // Ürün adı
  description String?  // Detaylı açıklama
  price       Decimal  @db.Decimal(10, 2) // Satış fiyatı
  isActive    Boolean  @default(true)     // Yayında mı?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categoryId  String
  brandId     String?
  isArchived  Boolean  @default(false)    // Arşivlendi mi?
  stock       Int      @default(0)        // Stok adedi
  salePrice   Decimal? @db.Decimal(10, 2) // İndirimli fiyat
  
  // İlişkiler
  favoritedBy Favorite[] // Favoriye alan kullanıcılar
  
  // Ana Ürün Miras Özellikleri
  defaultColor String? // Örn: "Kırmızı" veya boş
  defaultSize  String? // Örn: "L" veya "Standart"
  
  orderItems       OrderItem[]             // Sipariş detayları
  brand            Brand?                  @relation(fields: [brandId], references: [id])
  category         Category                @relation(fields: [categoryId], references: [id])
  attributeValues  ProductAttributeValue[] // Ürün özellikleri
  images           ProductImage[]          // Ürün resimleri
  variants         ProductVariant[]        // Varyantlar (Beden/Renk)
  reviews          Review[]                // Yorumlar
}

/// Ürün Resimleri
model ProductImage {
  id        String  @id @default(cuid())
  url       String  // Resim URL'i
  isMain    Boolean @default(false) // Ana resim mi?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Ürün Varyantları
/// Aynı ürünün farklı özelliklere sahip çeşitleri (Renk, Beden vb.)
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String   // Varyant adı "Kırmızı L"
  color     String?  // Renk kodu veya adı
  size      String?  // Beden
  stock     Int      @default(0) // Varyant stoğu
  price     Decimal? @db.Decimal(10, 2) // Varyanta özel fiyat (varsa)
  salePrice Decimal? @db.Decimal(10, 2) // Varyanta özel indirimli fiyat
  image     String?  // Varyanta özel resim
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Özellik Tanımları
/// Kategorilere atanabilen dinamik özellikler (Örn: Ekran Boyutu, Materyal)
model Attribute {
  id         String                  @id @default(cuid())
  name       String                  // Özellik adı
  categoryId String
  category   Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values     ProductAttributeValue[] // Bu özelliğin aldığı değerler
}

/// Ürün Özellik Değerleri
/// Bir ürünün belirli bir özelliğe verdiği değer
model ProductAttributeValue {
  id          String    @id @default(cuid())
  value       String    // Değer (örn: "6.1 inç", "Pamuk")
  productId   String
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// SİPARİŞ & ÖZELLİK MODELLERİ
// --------------------------------------

/// Sipariş Modeli
/// Müşteri siparişlerini ve durumunu takip eder.
model Order {
  id           String      @id @default(cuid())
  userId       String?     // Siparişi veren kullanıcı (Misafir de olabilir)
  total        Decimal     @db.Decimal(10, 2) // Toplam Tutar
  status       OrderStatus @default(PENDING) // Sipariş Durumu
  customerName String      // Müşteri Adı (Snapshot)
  customerEmail String     // Müşteri E-postası (Snapshot)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  address      String?     // Teslimat Adresi (Snapshot)
  cancelReason String?     // İptal Nedeni
  
  user         User?       @relation(fields: [userId], references: [id])
  items        OrderItem[] // Sipariş Kalemleri
}

/// Sipariş Kalemi
/// Siparişteki her bir ürün satırını ifade eder.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String? // Hangi varyantın alındığı
  quantity  Int     // Adet
  price     Decimal @db.Decimal(10, 2) // Satış anındaki birim fiyat (Fiyat değişse bile bu sabit kalmalı)
  
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

/// İndirim Kuponu Modeli
model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique // Kupon Kodu (Örn: YAZ50)
  type       CouponType @default(PERCENTAGE) // İndirim Tipi (Yüzde/Sabit)
  value      Decimal    @db.Decimal(10, 2)   // Değer (Örn: %10 veya 100TL)
  minAmount  Decimal?   @db.Decimal(10, 2)   // Minimum Sepet Tutarı
  isActive   Boolean    @default(true)
  startDate  DateTime?  // Başlangıç Tarihi
  endDate    DateTime?  // Bitiş Tarihi
  usageLimit Int?       // Toplam Kullanım Limiti
  usedCount  Int        @default(0) // Kaç kez kullanıldı?
    
  // Kategori İlişkisi (Hangi kategoride geçerli?)
  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id])

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// Favori Ürünler
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

/// Ürün Yorumları ve Değerlendirmeleri
model Review {
  id         String   @id @default(cuid())
  rating     Int      @default(5) // 1-5 arası puan
  comment    String?  // Yorum metni
  isApproved Boolean  @default(false) // Admin onayı
  userId     String
  productId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // Bir kullanıcı bir ürüne tek yorum yapabilir
}

// --------------------------------------
// SİSTEM & OPERASYON MODELLERİ
// --------------------------------------

/// Genel Site Ayarları
/// Admin panelinden yönetilebilir site konfigürasyonu.
model Settings {
  id           String  @id @default("general_settings") // Tek bir kayıt olacak
  siteTitle    String  @default("KervanPazar")
  slogan       String? // Site sloganı
  description  String? // SEO açıklaması
  contactEmail String? // İletişim e-postası
  contactPhone String? // İletişim telefonu
  address      String? // Firma adresi
  instagram    String? // Sosyal medya linkleri
  facebook     String?
  twitter      String?
  maintenance  Boolean @default(false) // Bakım modu
}

/// Denetim Günlüğü (Audit Logs)
/// Admin panelinde yapılan önemli işlemlerin kaydı.
model AuditLog {
  id         String   @id @default(cuid())
  action     String   // İşlem adı (CREATE_PRODUCT vb.)
  details    String?  // Detaylı açıklama
  adminId    String?  // İşlemi yapan kullanıcı ID'si aka userId
  adminEmail String?  // İşlemi yapan kullanıcı E-postası aka email
  role       String   @default("ADMIN") // Kullanıcı rolü (ADMIN, USER)
  metadata   Json?    // Ekstra veriler (Hata kodu, tarayıcı detayı vs.)
  ipAddress  String?  // IP Adresi
  userAgent  String?  // Tarayıcı bilgisi
  createdAt  DateTime @default(now())
}

/// Banner Yönetimi
/// Ana sayfadaki slider ve promosyon alanları için.
model Banner {
  id          String   @id @default(uuid())
  title       String   
  description String?  
  imageUrl    String   
  link        String?  // Tıklanınca gideceği URL
  isActive    Boolean  @default(true) 
  order       Int      @default(0)    // Gösterim sırası
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Şifre Sıfırlama Tokenları
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime // Geçerlilik süresi

  @@unique([email, token])
}

// ✅ YENİ EKLENEN: İade ve Değişim Talepleri
/// İade Talep Modeli
model ReturnRequest {
  id          String       @id @default(cuid())
  orderNumber String       // Kullanıcının girdiği sipariş numarası
  email       String       // İletişim e-postası
  reason      String       // İade nedeni (enum veya string tutulabilir, formda selectbox var)
  description String?      // Kullanıcının açıklaması
  status      ReturnStatus @default(PENDING) // Talep durumu
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// --------------------------------------
// ENUM TANIMLARI (TİPLER)
// --------------------------------------

/// İade Durumları
enum ReturnStatus {
  PENDING   // Bekliyor
  APPROVED  // Onaylandı
  REJECTED  // Reddedildi
  COMPLETED // Tamamlandı (Para iadesi yapıldı vb.)
}

/// Kullanıcı Rolleri
enum Role {
  USER        // Normal Müşteri
  ADMIN       // Yönetici
  SUPER_ADMIN // 👑 Patron bu! (Tam yetkili)
}

/// Kupon Tipleri
enum CouponType {
  PERCENTAGE // Yüzde İndirim (%)
  FIXED      // Sabit Tutar (TL)
}

/// Sipariş Durumları
enum OrderStatus {
  PENDING     // Beklemede (Ödeme bekliyor veya onay bekliyor)
  PROCESSING  // Hazırlanıyor
  PAID        // Ödendi
  SHIPPED     // Kargolandı
  DELIVERED   // Teslim Edildi
  CANCELLED   // İptal Edildi
  REFUNDED    // İade Edildi
}